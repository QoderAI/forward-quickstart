{
  "name": "forward-quickstart",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "test:deployment": "npm run build --workspace=server && tsx --test tests/voiceDeployment.test.ts tests/voiceParity.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
